{
  "name": "incott-mouse-app",
  "version": "1.0.1",
  "description": "Incott 鼠标驱动 - 独立的桌面配置工具（基于逆向的 HID 协议，不依赖网页驱动）",
  "main": "src/main/index.js",
  "author": "Incott Dev",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "assets": "electron build/make-assets.js",
    "dist": "electron-builder",
    "setup:payload": "node installer/sync-payload.js",
    "setup": "node installer/sync-payload.js && electron-builder --projectDir installer --config electron-builder.yml && node installer/collect.js"
  },
  "dependencies": {
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.incott.mouseapp",
    "productName": "Incott Mouse Driver",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "docs/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/generated/icon.ico",
      "artifactName": "Incott-Mouse-Driver-NSIS-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/generated/icon.ico",
      "uninstallerIcon": "build/generated/icon.ico",
      "installerHeader": "build/generated/installerHeader.bmp",
      "installerHeaderIcon": "build/generated/icon.ico",
      "installerSidebar": "build/generated/installerSidebar.bmp",
      "uninstallerSidebar": "build/generated/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Incott Mouse Driver",
      "uninstallDisplayName": "Incott Mouse Driver ${version}",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Incott-Mouse-Driver-NSIS-${version}.${ext}"
    }
  }
}
